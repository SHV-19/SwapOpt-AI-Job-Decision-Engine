{
  "manifest_version": 3,
  "name": "SwapOpt AI",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "description": "Analyze job descriptions, tailor application materials, generate resumes, cover letters, networking strategies, and track job applications.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "SwapOpt AI",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}